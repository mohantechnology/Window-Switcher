<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:converters="clr-namespace:WindowSwitcher.Windows.Converters"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Topmost="True"
        x:Class="WindowSwitcher.Windows.SettingsWindow"
        WindowDecorations="Full"
        Title="Settings"
        x:DataType="viewModels:SettingsViewModel">
        <Window.Resources>
                <converters:ColorStringValueConverter x:Key="ColorStringValueConverter" />
        </Window.Resources>
        <StackPanel Margin="10"
                    MinWidth="200"
                    Spacing="8"
                    Orientation="Vertical">
                <StackPanel Spacing="6">
                        <CheckBox Content="Move windows"
                                  IsChecked="{Binding MoveWindows, Mode=TwoWay}" />
                        <CheckBox Content="Focus on hover"
                                  IsChecked="{Binding FocusOnHover, Mode=TwoWay}" />
                        <CheckBox Content="Change size on hover"
                                  IsChecked="{Binding ChangeSizeOnHover, Mode=TwoWay}" />
                        <CheckBox Content="Change opacity on hover"
                                  IsChecked="{Binding ChangeOpacityOnHover, Mode=TwoWay}" />
                        <Grid Margin="18 0 0 0"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Default opacity" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                        <Slider Width="140"
                                                Minimum="0.2"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding DefaultPreviewOpacity, Mode=TwoWay}" />
                                        <TextBlock MinWidth="40"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DefaultPreviewOpacity, StringFormat={}{0:P0}}" />
                                </StackPanel>
                        </Grid>
                        <CheckBox Content="Enable previews"
                                  IsChecked="{Binding EnablePreviews, Mode=TwoWay}" />
                        <Grid Margin="18 0 0 0"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              IsEnabled="{Binding EnablePreviews}">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Preview frame rate" />
                                <NumericUpDown Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Value="{Binding PreviewFrameRate, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="30"
                                               Increment="1" />
                        </Grid>
                        <CheckBox Content="Enable pin focused window"
                                  IsChecked="{Binding EnablePinFocusedWindow, Mode=TwoWay}" />
                        <CheckBox Content="Start minimized"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                        <CheckBox Content="Auto start on every boot"
                                  IsChecked="{Binding AutoStartInBackground, Mode=TwoWay}" />
                        <TextBlock Text="{Binding AutoStartError}"
                                   IsVisible="{Binding HasAutoStartError}"
                                   TextWrapping="Wrap"
                                   Foreground="IndianRed"
                                   MaxWidth="280" />
                </StackPanel>

                <StackPanel Spacing="6">
                        <CheckBox Content="Resize windows"
                                  IsChecked="{Binding ResizeWindows, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditResizeWindows}" />
                        <CheckBox Content="Link width and height"
                                  IsChecked="{Binding LinkPreviewAspectRatio, Mode=TwoWay}" />
                        <CheckBox Content="Fixed size"
                                  IsChecked="{Binding UseFixedWindowSize, Mode=TwoWay}" />
                        <CheckBox Content="Default window size"
                                  IsChecked="{Binding UseDefaultWindowSize, Mode=TwoWay}" />
                        <Grid IsEnabled="{Binding CanEditWindowSize}"
                              Margin="18 0 0 0"
                              HorizontalAlignment="Stretch"
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="6">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Text="Width" />
                                <NumericUpDown Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Value="{Binding WindowWidth, Mode=TwoWay}"
                                               Minimum="10"
                                               Maximum="2000"
                                               Increment="1" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Text="Height" />
                                <NumericUpDown Grid.Row="1"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Value="{Binding WindowHeight, Mode=TwoWay}"
                                               Minimum="10"
                                               Maximum="2000"
                                               Increment="1" />
                        </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="120,Auto"
                              ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Highlight color" />
                                 <colorPicker:ColorPicker Grid.Column="1"
                                                          Width="60"
                                                          Color="{Binding PreviewHighlightColor, Mode=TwoWay, Converter={StaticResource ColorStringValueConverter}}"
                                                          IsAlphaVisible="False" />
                        </Grid>
                </StackPanel>
        </StackPanel>
</Window>
